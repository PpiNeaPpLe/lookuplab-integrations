{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "lookuplab": {
      "type": "streamable-http",
      "url": "https://lookuplab.io/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "provided", "clientId": "lookuplab-openai", "tokenEndpointAuthMethod": "none" },
            "authorizationUrl": "https://lookuplab.io/oauth/authorize/",
            "tokenUrl": "https://lookuplab.io/oauth/token/",
            "authorizationServerBase": "https://lookuplab.io",
            "resource": "https://lookuplab.io/api/mcp",
            "baseScopes": ["lookups:execute"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
